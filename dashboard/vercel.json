{
  "redirects": [
    {
      "source": "/",
      "destination": "/preview",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/preview",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
