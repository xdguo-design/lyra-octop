@prefix his: <urn:his:core:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

his:Ontology a owl:Ontology ;
    rdfs:label "HIS Core Ontology"@en, "HIS 核心本体"@zh ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "Shared semantic vocabulary for HIS domains. Workflow execution and authorization remain in domain services."@en .

# Shared people and organization concepts
his:Entity a owl:Class ; rdfs:label "业务实体"@zh .
his:Person a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "自然人"@zh .
his:Patient a owl:Class ; rdfs:subClassOf his:Person ; rdfs:label "患者"@zh .
his:Practitioner a owl:Class ; rdfs:subClassOf his:Person ; rdfs:label "医务人员"@zh .
his:Organization a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "医疗机构"@zh .
his:Department a owl:Class ; rdfs:subClassOf his:Organization ; rdfs:label "科室"@zh .
his:CareLocation a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "诊疗地点"@zh .
his:CareTeam a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "医疗团队"@zh .
his:Workgroup a owl:Class ; rdfs:subClassOf his:CareTeam ; rdfs:label "工作组"@zh .
his:WorkgroupMembership a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "工作组成员关系"@zh .

# Registration, appointment, outpatient and inpatient contexts are distinct concepts.
his:RegistrationRecord a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "挂号记录"@zh .
his:Appointment a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "预约"@zh .
his:OutpatientQueueEntry a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "门诊候诊队列项"@zh .
his:Encounter a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "临床就诊"@zh .
his:OutpatientEncounter a owl:Class ; rdfs:subClassOf his:Encounter ; rdfs:label "门诊就诊"@zh .
his:InpatientEncounter a owl:Class ; rdfs:subClassOf his:Encounter ; rdfs:label "住院诊疗活动"@zh .
his:AdmissionRequest a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "入院申请"@zh .
his:AdmissionEpisode a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "住院事件"@zh .
his:CareTransition a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "诊疗流转"@zh .

# Clinical statements are patient-specific facts about clinical concepts.
his:ClinicalAssertion a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "临床事实记录"@zh .
his:DiagnosisAssertion a owl:Class ; rdfs:subClassOf his:ClinicalAssertion ; rdfs:label "诊断记录"@zh .
his:Observation a owl:Class ; rdfs:subClassOf his:ClinicalAssertion ; rdfs:label "观察/测量记录"@zh .
his:ClinicalDocument a owl:Class ; rdfs:subClassOf his:ClinicalAssertion ; rdfs:label "临床文书"@zh .
his:MedicalConcept a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "医学概念"@zh .
his:ConditionConcept a owl:Class ; rdfs:subClassOf his:MedicalConcept ; rdfs:label "疾病/病情概念"@zh .

# Orders, fulfillment and results remain separate from payment and encounter state.
his:ClinicalOrder a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "临床医嘱"@zh .
his:MedicationOrder a owl:Class ; rdfs:subClassOf his:ClinicalOrder ; rdfs:label "用药医嘱"@zh .
his:ServiceOrder a owl:Class ; rdfs:subClassOf his:ClinicalOrder ; rdfs:label "诊疗服务医嘱"@zh .
his:OutpatientOrder a owl:Class ; rdfs:subClassOf his:ClinicalOrder ; rdfs:label "门诊医嘱"@zh .
his:InpatientOrder a owl:Class ; rdfs:subClassOf his:ClinicalOrder ; rdfs:label "住院医嘱"@zh .
his:OrderApplication a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "医嘱申请单"@zh .
his:DrugApplication a owl:Class ; rdfs:subClassOf his:OrderApplication ; rdfs:label "药品申请单"@zh .
his:ExamApplication a owl:Class ; rdfs:subClassOf his:OrderApplication ; rdfs:label "检查申请单"@zh .
his:LabApplication a owl:Class ; rdfs:subClassOf his:OrderApplication ; rdfs:label "检验申请单"@zh .
his:SurgeryApplication a owl:Class ; rdfs:subClassOf his:OrderApplication ; rdfs:label "手术申请单"@zh .
his:ServiceApplication a owl:Class ; rdfs:subClassOf his:OrderApplication ; rdfs:label "治疗申请单"@zh .
his:TransfusionApplication a owl:Class ; rdfs:subClassOf his:OrderApplication ; rdfs:label "输血申请单"@zh .
his:ApplicationDetail a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "申请单明细"@zh .
his:DrugApplicationDetail a owl:Class ; rdfs:subClassOf his:ApplicationDetail ; rdfs:label "药品申请明细"@zh .
his:ExamApplicationDetail a owl:Class ; rdfs:subClassOf his:ApplicationDetail ; rdfs:label "检查申请明细"@zh .
his:LabApplicationDetail a owl:Class ; rdfs:subClassOf his:ApplicationDetail ; rdfs:label "检验申请明细"@zh .
his:SurgeryApplicationDetail a owl:Class ; rdfs:subClassOf his:ApplicationDetail ; rdfs:label "手术申请明细"@zh .
his:ServiceApplicationDetail a owl:Class ; rdfs:subClassOf his:ApplicationDetail ; rdfs:label "治疗申请明细"@zh .
his:TransfusionApplicationDetail a owl:Class ; rdfs:subClassOf his:ApplicationDetail ; rdfs:label "输血申请明细"@zh .
his:AnatomicalSite a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "检查部位"@zh .
his:SurgerySession a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "连台手术组"@zh .
his:Procedure a owl:Class ; rdfs:subClassOf his:ClinicalAssertion ; rdfs:label "医疗操作/手术事实"@zh .
his:OrderExecution a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "医嘱执行记录"@zh .
his:DiagnosticReport a owl:Class ; rdfs:subClassOf his:ClinicalAssertion ; rdfs:label "检查/检验报告"@zh .
his:MedicationDispense a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "药品发放记录"@zh .

# Financial records link to care but do not become clinical-order states.
his:ClinicalService a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "医疗服务"@zh .
his:ChargeItem a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "收费项目"@zh .
his:Invoice a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "票据"@zh .
his:PaymentTransaction a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "支付交易"@zh .

# Terminology and local catalog concepts are versionable semantic entities.
his:CodeSystem a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "术语编码体系"@zh .
his:TerminologyConcept a owl:Class ; rdfs:subClassOf his:MedicalConcept ; rdfs:label "标准术语概念"@zh .
his:ConditionTerminologyConcept a owl:Class ;
    rdfs:subClassOf his:ConditionConcept, his:TerminologyConcept ;
    rdfs:label "标准疾病/病情术语概念"@zh .
his:HospitalCatalogEntry a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "院内目录项"@zh .
his:ConceptMapping a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "概念映射"@zh .
his:AuditRecord a owl:Class ; rdfs:subClassOf his:Entity ; rdfs:label "审计记录"@zh .

# Cross-domain relationships. Domain/range constrain semantic types, not workflow states.
his:hasEncounter a owl:ObjectProperty ; rdfs:domain his:Patient ; rdfs:range his:Encounter ; rdfs:label "有临床就诊"@zh .
his:hasRegistration a owl:ObjectProperty ; rdfs:domain his:Patient ; rdfs:range his:RegistrationRecord ; rdfs:label "有挂号记录"@zh .
his:registrationForPatient a owl:ObjectProperty ; rdfs:domain his:RegistrationRecord ; rdfs:range his:Patient ; rdfs:label "挂号患者"@zh .
his:registrationForDepartment a owl:ObjectProperty ; rdfs:domain his:RegistrationRecord ; rdfs:range his:Department ; rdfs:label "挂号科室"@zh .
his:registrationForPractitioner a owl:ObjectProperty ; rdfs:domain his:RegistrationRecord ; rdfs:range his:Practitioner ; rdfs:label "挂号医生"@zh .
his:opensEncounter a owl:ObjectProperty ; rdfs:domain his:RegistrationRecord ; rdfs:range his:OutpatientEncounter ; rdfs:label "关联门诊就诊"@zh .
his:hasQueueEntry a owl:ObjectProperty ; rdfs:domain his:RegistrationRecord ; rdfs:range his:OutpatientQueueEntry ; rdfs:label "进入候诊队列"@zh .
his:queueForRegistration a owl:ObjectProperty ; rdfs:domain his:OutpatientQueueEntry ; rdfs:range his:RegistrationRecord ; rdfs:label "队列对应挂号"@zh .
his:queueInWorkgroup a owl:ObjectProperty ; rdfs:domain his:OutpatientQueueEntry ; rdfs:range his:Workgroup ; rdfs:label "队列归属工作组"@zh .
his:queueForPractitioner a owl:ObjectProperty ; rdfs:domain his:OutpatientQueueEntry ; rdfs:range his:Practitioner ; rdfs:label "队列分配医生"@zh .
his:hasMembership a owl:ObjectProperty ; rdfs:domain his:Workgroup ; rdfs:range his:WorkgroupMembership ; rdfs:label "包含成员关系"@zh .
his:membershipForPractitioner a owl:ObjectProperty ; rdfs:domain his:WorkgroupMembership ; rdfs:range his:Practitioner ; rdfs:label "成员医务人员"@zh .
his:membershipInWorkgroup a owl:ObjectProperty ; rdfs:domain his:WorkgroupMembership ; rdfs:range his:Workgroup ; rdfs:label "所属工作组"@zh .
his:primaryWorkgroup a owl:ObjectProperty ; rdfs:domain his:Practitioner ; rdfs:range his:Workgroup ; rdfs:label "主工作组"@zh .
his:forPatient a owl:ObjectProperty ; rdfs:domain his:AdmissionEpisode ; rdfs:range his:Patient ; rdfs:label "住院患者"@zh .
his:containsEncounter a owl:ObjectProperty ; rdfs:domain his:AdmissionEpisode ; rdfs:range his:InpatientEncounter ; rdfs:label "包含住院诊疗活动"@zh .
his:hasDiagnosis a owl:ObjectProperty ; rdfs:domain his:Encounter ; rdfs:range his:DiagnosisAssertion ; rdfs:label "记录诊断"@zh .
his:assertsCondition a owl:ObjectProperty ; rdfs:domain his:DiagnosisAssertion ; rdfs:range his:ConditionConcept ; rdfs:label "断言病情概念"@zh .
his:aboutPatient a owl:ObjectProperty ; rdfs:domain his:ClinicalAssertion ; rdfs:range his:Patient ; rdfs:label "关于患者"@zh .
his:inEncounter a owl:ObjectProperty ; rdfs:domain his:ClinicalAssertion ; rdfs:range his:Encounter ; rdfs:label "发生于就诊"@zh .
his:recordedBy a owl:ObjectProperty ; rdfs:domain his:ClinicalAssertion ; rdfs:range his:Practitioner ; rdfs:label "记录者"@zh .
his:hasOrder a owl:ObjectProperty ; rdfs:domain his:Encounter ; rdfs:range his:ClinicalOrder ; rdfs:label "开立医嘱"@zh .
his:hasApplication a owl:ObjectProperty ; rdfs:domain his:ClinicalOrder ; rdfs:range his:OrderApplication ; rdfs:label "对应申请单"@zh .
his:hasApplicationDetail a owl:ObjectProperty ; rdfs:domain his:OrderApplication ; rdfs:range his:ApplicationDetail ; rdfs:label "包含申请明细"@zh .
his:hasExamSite a owl:ObjectProperty ; rdfs:domain his:ExamApplicationDetail ; rdfs:range his:AnatomicalSite ; rdfs:label "检查部位"@zh .
his:inSurgerySession a owl:ObjectProperty ; rdfs:domain his:SurgeryApplicationDetail ; rdfs:range his:SurgerySession ; rdfs:label "属于连台手术组"@zh .
his:orderedBy a owl:ObjectProperty ; rdfs:domain his:ClinicalOrder ; rdfs:range his:Practitioner ; rdfs:label "医嘱开立者"@zh .
his:fulfilledBy a owl:ObjectProperty ; rdfs:domain his:ClinicalOrder ; rdfs:range his:OrderExecution ; rdfs:label "由执行记录履行"@zh .
his:producesReport a owl:ObjectProperty ; rdfs:domain his:ClinicalOrder ; rdfs:range his:DiagnosticReport ; rdfs:label "产生报告"@zh .
his:dispenses a owl:ObjectProperty ; rdfs:domain his:MedicationOrder ; rdfs:range his:MedicationDispense ; rdfs:label "对应发药"@zh .
his:generatesCharge a owl:ObjectProperty ; rdfs:domain his:ClinicalService ; rdfs:range his:ChargeItem ; rdfs:label "产生收费项目"@zh .
his:settles a owl:ObjectProperty ; rdfs:domain his:PaymentTransaction ; rdfs:range his:Invoice ; rdfs:label "结算票据"@zh .
his:usesCodeSystem a owl:ObjectProperty ; rdfs:domain his:TerminologyConcept ; rdfs:range his:CodeSystem ; rdfs:label "属于编码体系"@zh .
his:denotesConcept a owl:ObjectProperty ; rdfs:domain his:HospitalCatalogEntry ; rdfs:range his:MedicalConcept ; rdfs:label "表示医学概念"@zh .
his:mappingSource a owl:ObjectProperty ; rdfs:domain his:ConceptMapping ; rdfs:range his:MedicalConcept ; rdfs:label "映射源概念"@zh .
his:mappingTarget a owl:ObjectProperty ; rdfs:domain his:ConceptMapping ; rdfs:range his:MedicalConcept ; rdfs:label "映射目标概念"@zh .
his:audits a owl:ObjectProperty ; rdfs:domain his:AuditRecord ; rdfs:range his:Entity ; rdfs:label "审计对象"@zh .

# Object properties used by runtime queries; codes and dates remain data properties.
his:code a owl:DatatypeProperty ; rdfs:domain his:MedicalConcept ; rdfs:range rdfs:Literal ; rdfs:label "编码"@zh .
his:codeVersion a owl:DatatypeProperty ; rdfs:domain his:MedicalConcept ; rdfs:range rdfs:Literal ; rdfs:label "编码版本"@zh .
his:effectiveFrom a owl:DatatypeProperty ; rdfs:domain his:Entity ; rdfs:range rdfs:Literal ; rdfs:label "生效时间"@zh .
his:effectiveTo a owl:DatatypeProperty ; rdfs:domain his:Entity ; rdfs:range rdfs:Literal ; rdfs:label "失效时间"@zh .
his:registrationStatus a owl:DatatypeProperty ; rdfs:domain his:RegistrationRecord ; rdfs:range rdfs:Literal ; rdfs:label "挂号状态"@zh .
his:queueStatus a owl:DatatypeProperty ; rdfs:domain his:OutpatientQueueEntry ; rdfs:range rdfs:Literal ; rdfs:label "候诊状态"@zh .
his:membershipRole a owl:DatatypeProperty ; rdfs:domain his:WorkgroupMembership ; rdfs:range rdfs:Literal ; rdfs:label "成员角色"@zh .
his:outpatientOrderType a owl:DatatypeProperty ; rdfs:domain his:OutpatientOrder ; rdfs:range rdfs:Literal ; rdfs:label "门诊医嘱类型"@zh .
his:inpatientOrderKind a owl:DatatypeProperty ; rdfs:domain his:InpatientOrder ; rdfs:range rdfs:Literal ; rdfs:label "住院长期/临时医嘱"@zh .
his:orderStatus a owl:DatatypeProperty ; rdfs:domain his:ClinicalOrder ; rdfs:range rdfs:Literal ; rdfs:label "医嘱状态枚举"@zh .
