# Platform API origin. Never point this at a caller-controlled URL.
OCTOP_API_BASE_URL=http://127.0.0.1:8200
# Public, read-only endpoint of demos/administrative-regions.
REGIONS_SERVICE_URL=http://127.0.0.1:8210/api/regions
# Keep backend local; deployment should expose it only through the Octop same-origin proxy.
ADMISSION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
